---
import BaseLayout from '../layouts/BaseLayout.astro';
const tools = [
  { link: '/cv/', num:'01', title:'Aletheia CV', desc:'Extraia informações de PDF, DOCX e TXT, edite o currículo e gere PDF com Typst local.', tag:'CURRÍCULOS', color:'bg-indigo-500' },
  { link: '/bg-remover/', num:'02', title:'Remover fundo', desc:'Remova fundos de imagens usando modelo de IA no navegador, sem enviar imagens ao nosso servidor.', tag:'IMAGENS + IA', color:'bg-emerald-500' },
  { link: '/converter/', num:'03', title:'Conversor local', desc:'Converta imagens, extraia documentos e transforme CSV/JSON. Arquivos processados no navegador.', tag:'ARQUIVOS', color:'bg-violet-500' }
];
---
<BaseLayout title="Ferramentas locais" description="Aletheia: currículos, remoção de fundo e conversões locais no navegador.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <section class="max-w-4xl mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 mb-6 px-3 py-2 border-2 border-[var(--edge)] font-['Silkscreen'] text-xs bg-[var(--panel)]"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> FERRAMENTAS PRIVADAS E ACESSÍVEIS</div>
      <h1 class="font-['Silkscreen'] text-3xl sm:text-5xl md:text-6xl leading-[1.3] font-bold tracking-tight mb-6">Ferramentas úteis.<br/><span class="text-indigo-600 dark:text-indigo-300">Sem complicação.</span></h1>
      <p class="text-lg sm:text-xl muted max-w-2xl leading-relaxed">Uma coleção de utilitários para currículos, imagens e arquivos. A maior parte do trabalho acontece no seu próprio dispositivo.</p>
    </section>
    <section class="grid lg:grid-cols-3 gap-6 mb-14" aria-label="Escolha uma ferramenta">
      {tools.map(t => <a href={t.link} class="tool-card p-6 min-h-[300px] text-[var(--text)] no-underline">
        <div class="flex justify-between items-start mb-7"><span class={`w-12 h-12 grid place-items-center text-white border-2 border-[var(--edge)] font-['Silkscreen'] ${t.color}`}>{t.num}</span><span class="text-xs font-['Silkscreen'] muted">{t.tag}</span></div>
        <h2 class="font-['Silkscreen'] text-xl mb-4">{t.title}</h2><p class="muted leading-relaxed flex-1">{t.desc}</p>
        <span class="font-['Silkscreen'] text-sm mt-5 text-indigo-600 dark:text-indigo-300">ABRIR →</span>
      </a>)}
    </section>
    <section class="grid lg:grid-cols-2 gap-6">
      <div class="pixel p-6"><h2 class="section-heading mb-3">PRIVACIDADE PRIMEIRO</h2><p class="muted leading-relaxed">Seu currículo e suas imagens são processados localmente. Modelos e bibliotecas podem ser baixados na primeira utilização. Nada é enviado a um backend do Aletheia.</p></div>
      <div class="pixel p-6"><h2 class="section-heading mb-3">CÓDIGO ABERTO</h2><p class="muted leading-relaxed">Astro + Svelte 5 + WebAssembly. Funciona em hospedagem estática e recebe melhorias sem depender de conta ou login.</p></div>
    </section>
  </div>
</BaseLayout>
