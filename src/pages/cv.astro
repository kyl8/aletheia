---
import BaseLayout from '../layouts/BaseLayout.astro';
import CVEditor from '../components/CVEditor.svelte';
---
<BaseLayout title="Criador de currículo" description="Crie, importe, revise e exporte currículos PDF e Typst localmente.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10">
    <p class="font-['Silkscreen'] text-xs text-indigo-600 dark:text-indigo-300 mb-3">ALETHEIA / CV</p>
    <h1 class="font-['Silkscreen'] text-2xl sm:text-3xl mb-3">Seu currículo, suas regras.</h1>
    <p class="muted max-w-3xl">Importe um arquivo ou crie do zero. Confira os campos extraídos antes de exportar, pois a identificação automática pode errar.</p>
  </section>
  <CVEditor client:only="svelte" />
</BaseLayout>
