---
import '../styles/global.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const links = [
  { href: '/', label: 'Início' },
  { href: '/cv/', label: 'Currículos' },
  { href: '/bg-remover/', label: 'Remover fundo' },
  { href: '/converter/', label: 'Conversor' }
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet" />
    <title>{title} · Aletheia</title>
    <script is:inline>
      try {
        const stored = localStorage.getItem('aletheia.theme');
        document.documentElement.classList.toggle('dark', stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
      } catch { /* browser privacy mode */ }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3">Ir para conteúdo</a>
    <header class="w-full border-b-2 border-[var(--edge)] bg-[var(--panel)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex flex-wrap items-center gap-x-6 gap-y-4 justify-between">
        <a href="/" class="flex items-center gap-3 no-underline text-[var(--text)]" aria-label="Aletheia, página inicial">
          <span class="grid place-items-center bg-indigo-500 text-white font-bold w-10 h-10 pixel">A</span>
          <span class="font-['Silkscreen'] font-bold text-xl tracking-tight">ALETHEIA</span>
        </a>
        <nav class="flex flex-wrap gap-2 sm:gap-4 items-center" aria-label="Ferramentas">
          {links.map(link => <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined} class:list={['px-2 py-2 text-sm font-semibold hover:text-indigo-500 dark:hover:text-indigo-300', { 'underline decoration-indigo-500 underline-offset-8': Astro.url.pathname === link.href }]}>{link.label}</a>)}
          <button id="theme-toggle" type="button" class="pixel-button px-3 py-2 bg-zinc-100 dark:bg-zinc-800" aria-label="Alternar tema">◐ <span class="hidden sm:inline">Tema</span></button>
        </nav>
      </div>
    </header>
    <main id="main" class="w-full flex-1"><slot /></main>
    <footer class="border-t-2 border-[var(--edge)] mt-16 py-6 px-4 text-sm muted">
      <div class="max-w-7xl mx-auto flex flex-wrap justify-between gap-3"><span>© {new Date().getFullYear()} Aletheia · Ferramentas no navegador</span><a class="underline hover:text-indigo-500" href="https://github.com/kyl8/aletheia" target="_blank" rel="noopener noreferrer">Código no GitHub</a></div>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('aletheia.theme', isDark ? 'dark' : 'light'); } catch {}
      });
    </script>
  </body>
</html>
